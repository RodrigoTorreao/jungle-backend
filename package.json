{
  "name": "jungle-wagering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "migration:create": "bun scripts/migrate.ts create",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:unit": "bun test ./test/unit",
    "test:integration": "bun test --preload ./test/support/integration-preload.ts ./test/integration",
    "test:concurrency": "bun test --preload ./test/support/integration-preload.ts ./test/concurrency --pass-with-no-tests",
    "test:load": "bun load/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1159.0",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.203.0",
    "@opentelemetry/instrumentation": "0.203.0",
    "@opentelemetry/instrumentation-http": "0.203.0",
    "@opentelemetry/instrumentation-pg": "0.55.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-trace-base": "2.0.1",
    "@opentelemetry/sdk-trace-node": "2.0.1",
    "@opentelemetry/semantic-conventions": "1.36.0",
    "jose": "^6.2.14",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "kysely@0.29.6": "patches/kysely@0.29.6.patch"
  }
}
