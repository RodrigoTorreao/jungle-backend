NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_ROLES=api

# Runtime connection (least-privilege role)
DATABASE_URL=postgres://wallet_app:wallet_app@localhost:5432/wagering
# Migrations connection (schema owner)
MIGRATION_DATABASE_URL=postgres://wallet_owner:wallet_owner@localhost:5432/wagering
DATABASE_POOL_MAX=10
DATABASE_LOCK_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=5000

AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_WAGER_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_WAGER_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wagering-events.fifo
SQS_CONSUMER_NAME=wager-transactions
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
SQS_RETRY_BASE_SECONDS=2
SQS_RETRY_MAX_SECONDS=60

OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
PENDING_REFERENCE_POLL_INTERVAL_MS=1000
PENDING_REFERENCE_BATCH_SIZE=50
RECONCILIATION_INTERVAL_MS=60000
RECONCILIATION_SAMPLE_SIZE=25

SHUTDOWN_GRACE_MS=20000

# Authentication extension point (ARCHITECTURE §11). Only "disabled" for now.
AUTH_MODE=disabled

# Test harness only: superuser used to create per-test databases
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
